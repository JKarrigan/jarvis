# Copy to .env.local and fill in what you need. Every variable is optional:
# with none set, the app runs in dev against mock media data and the default paths.
# Never commit real values (.env* is git-ignored except this file).

# ---------------------------------------------------------------- Air ---
# AirGradient device IP used by the browser when nothing is saved in Settings.
# NEXT_PUBLIC_DEVICE_HOST=192.168.1.50
# AirGradient device IP for the server-side poller (private IPv4 or *.local name).
# DEVICE_HOST=192.168.1.50
# Fallback coordinates for /api/outdoor-aqi when the client sends none.
# OUTDOOR_LAT=51.50
# OUTDOOR_LON=-0.12

# ----------------------------------------------------------- Database ---
# SQLite file (readings, events, settings, photos index). Default: ./airgradient.db
# Keeping it outside the checkout protects it from `git clean` and redeploys.
# DB_PATH=/home/pi/data/airgradient.db

# ---------------------------------------------------------- Documents ---
# Root of the Documents section (/media/documents, /api/files/*): the NAS
# `documents` share. On the Pi: /mnt/nas/documents (see docs/pi-deploy.md).
# Default: /mnt/storage
# FILES_ROOT=/mnt/nas/documents
# 1 = FILES_ROOT and PHOTOS_ROOT must be mount points; otherwise they count as
# offline (503, no writes), so nothing lands on the SD card under an empty
# mount point. Set on the Pi, leave unset in development.
# NAS_REQUIRE_MOUNT=1
# Disposable document thumbnails on local disk. Default: ./.files-cache
# FILES_CACHE=/home/pi/.cache/home-files
# pdftoppm (poppler-utils) for PDF thumbnails. Default: found on PATH; when it
# is missing PDFs simply show their type icon.
# PDFTOPPM_PATH=/usr/bin/pdftoppm
# Per-file upload cap in bytes for /api/files/upload. Default: 8 GiB.
# MAX_UPLOAD_BYTES=8589934592
# ffmpeg / ffprobe binaries (Photos, HEIC thumbnails, audiobook chapters). Default: found on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ------------------------------------------------------------- Photos ---
# Photo library. Default: $FILES_ROOT/Photos. Must be the NAS share on the Pi
# (see docs/photos-spec.md: the NAS owns the files, the Pi only indexes/serves).
# PHOTOS_ROOT=/mnt/nas/photo
# Disposable thumbnails/previews on the Pi's local disk. Default: ./.photos-cache
# PHOTOS_CACHE=/home/pi/.cache/home-photos

# ------------------------------------------------------ Media (Jellyfin) ---
# Jellyfin on the Synology NAS. Leave all JELLYFIN_* unset to use mock data.
# JELLYFIN_URL=http://192.168.1.20:8096
# The user the dashboard signs in as (token cached server-side).
# JELLYFIN_USER=
# JELLYFIN_PASSWORD=
# Alternative to user/password: an API key (server-side only), plus the user
# whose library/progress to use.
# JELLYFIN_API_KEY=
# JELLYFIN_USER_ID=
# Force mock media data even when JELLYFIN_* is set (UI work without the NAS).
# MEDIA_MOCK=1

# ---------------------------------------------------------------- Dev ---
# Extra hosts allowed to load the dev server, comma separated
# (e.g. your laptop's LAN IP so a phone can open http://<ip>:3000).
# Default: 192.168.1.13
# DEV_ORIGINS=192.168.1.13,my-laptop.local
